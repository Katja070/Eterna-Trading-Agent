# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Eterna MCP Gateway
ETERNA_MCP_URL=https://mcp.eterna.exchange/mcp
# API key from register_agent (run without this first, then add after registering)
ETERNA_API_KEY=eterna_mcp_your_key_here

# Strategy / risk settings
TRADING_OBJECTIVE=identify and execute profitable perpetual futures trades while rigorously managing risk
MAX_RISK_PCT=5.0         # max % of equity to risk per trade
DEFAULT_LEVERAGE=5       # default leverage
MAX_LEVERAGE=5           # hard ceiling (recommended: 5x)

# Preferred symbols for scanning (comma-separated)
PREFERRED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Agent loop
MAX_TOOL_ROUNDS=30       # max tool-use rounds before stopping
