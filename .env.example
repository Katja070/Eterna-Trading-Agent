# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Eterna MCP server
ETERNA_MCP_URL=https://mcp.eterna.exchange/mcp
ETERNA_API_KEY=your_eterna_api_key_here  # optional if server requires auth

# Strategy / risk settings
TRADING_OBJECTIVE=identify and execute profitable perpetual futures trades while rigorously managing risk
MAX_RISK_PCT=2.0         # max % of balance to risk per trade
DEFAULT_LEVERAGE=5       # default leverage for new positions
MAX_LEVERAGE=20          # hard ceiling on leverage
DEFAULT_SYMBOL=BTCUSDT

# Preferred symbols (comma-separated, no spaces)
PREFERRED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Agent loop
MAX_TOOL_ROUNDS=30       # max tool-use rounds before stopping
